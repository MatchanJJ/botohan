# Copy to .env.local and fill in. All of these are public: they end up in the browser bundle.

# Sepolia RPC. Use a provider key (Alchemy/Infura) for the workshop and restrict it to the Vercel domain.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# From contracts/deployments/sepolia.json
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Used for the QR code in present mode
NEXT_PUBLIC_SITE_URL=http://localhost:3000
